    "    color=\"0.4\",\n",
    "    linewidth=2.5,\n",
    "    linestyle=\"-.\",\n",
    "    label=\"Lehmer et al. (2019)\",\n",
    ")\n",
    "\n",
    "\n",
    "ax.set_xscale(\"log\")\n",
    "ax.set_yscale(\"log\")\n",
    "ax.set_xlim(X_MIN, X_MAX)\n",
    "ax.set_ylim(bottom=Y_MIN)\n",
    "ax.set_xlabel(\"X-ray luminosity (erg/s)\")\n",
    "ax.set_ylabel(\"N(>Lx) / SFR\")\n",
