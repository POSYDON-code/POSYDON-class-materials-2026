    "\n",
    "def lehmer_2019_cumulative_xlf(luminosity):\n",
    "    \"\"\"Cumulative HMXB XLF from Lehmer et al. (2019).\"\"\"\n",
    "\n",
    "    luminosity = np.asarray(luminosity, dtype=float)\n",
    "\n",
    "    K_HMXB = 1.96\n",
    "    gamma = 1.65\n",
    "    L_cut = 10.0**40.7\n",
    "\n",
    "    L38 = luminosity / 1.0e38\n",
    "    L38_cut = L_cut / 1.0e38\n",
    "\n",
    "    cumulative = np.zeros_like(luminosity)\n",
    "\n",
    "    below_cutoff = (luminosity > 0.0) & (luminosity < L_cut)\n",
    "\n",
    "    cumulative[below_cutoff] = K_HMXB / (gamma - 1.0) * (\n",
    "        L38[below_cutoff]**(1.0 - gamma)\n",
    "        - L38_cut**(1.0 - gamma)\n",
    "    )\n",
    "\n",
    "    return cumulative\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(7, 5.2))\n",
    "\n",
    "X_MIN, X_MAX = 1.0e35, 1.0e41\n",
    "Y_MIN = 1.\n",
    "\n",
    "styles = {\n",
    "    (\"BH\", \"RLO\"): (\"tab:blue\", \"-\"),\n",
    "    (\"NS\", \"RLO\"): (\"tab:orange\", \"-\"),\n",
    "    (\"BH\", \"wind\"): (\"tab:blue\", \"--\"),\n",
    "    (\"NS\", \"wind\"): (\"tab:orange\", \"--\"),\n",
    "    (\"BH\", \"Be\"): (\"tab:green\", \":\"),\n",
    "    (\"NS\", \"Be\"): (\"tab:red\", \":\"),\n",
    "}\n",
    "\n",
    "# Extend an XLF horizontally to X_MIN and vertically to Y_MIN.\n",
    "def plot_xlf(x, y, **kwargs):\n",
    "    if len(x):\n",
    "        x = np.r_[X_MIN, x, x[-1]]\n",
    "        y = np.r_[y[0], y, Y_MIN]\n",
    "        ax.step(x, y, where=\"post\", **kwargs)\n",
    "\n",
    "# Total XLF\n",
    "x_total, y_total = cumulative_xlf(luminosity, physical_weights)\n",
    "plot_xlf(\n",
    "    x_total, y_total, color=\"black\", linewidth=2.5, label=\"Total\"\n",
    ")\n",
    "\n",
    "# XLFs of the individual subpopulations\n",
    "table = XRBs.population\n",
    "\n",
    "for (compact_type, mode), (color, linestyle) in styles.items():\n",
    "    mask = (\n",
    "        table[\"accretor_state\"].eq(compact_type)\n",
    "        & table[\"accretion_mode\"].eq(mode)\n",
    "    ).to_numpy()\n",
    "\n",
    "    x_sub, y_sub = cumulative_xlf(\n",
    "        luminosity[mask], physical_weights[mask]\n",
    "    )\n",
    "\n",
    "    plot_xlf(\n",
    "        x_sub, y_sub,\n",
    "        color=color,\n",
    "        linestyle=linestyle,\n",
    "        label=f\"{compact_type} - {mode}\",\n",
    "    )\n",
    "\n",
    "L_lehmer = np.logspace(36.0, 40.7, 500)\n",
